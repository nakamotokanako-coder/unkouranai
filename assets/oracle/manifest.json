    "visualGrammar": [
      "白黒写真をベースにする",
      "主役となる大きなモチーフを1つ",
      "時代や用途の異なる日用品を1つ混ぜる",
      "1つだけ実物の色を強く残す",
      "写真、紙、印刷物、手描き表現を混在させる",
      "少し不自然なスケール差や配置を許可する",
      "意味を説明しすぎない",
      "3〜4要素程度で止める",
      "コラージュ内部にも呼吸できる余白を残す",
      "デジタル合成を綺麗にしすぎない"
    ],
    "meaningBalance": "70% suggestive meaning / 30% unexplained juxtaposition; qualitative direction, not a measurable score.",
    "grayscalePercentTarget": [70, 85],
    "selectiveColorPercentTarget": [15, 30],
    "colorRatioScope": "Artwork only, excluding transparent padding; targets, not measured properties of the master.",
    "primaryAccentColors": 1,
    "allowedAccents": ["fluorescent-pink", "antique-or-metallic-gold", "deep-red", "turquoise-or-cyan", "occasional-iridescence"],
    "charactersInGeneratedImage": false,
    "additionalProductionAuthorized": false
